# Translation catalogs (scripts/gen_i18n.py): the .ts stays LF on every checkout, and the
# compiled .qm committed beside it is binary.
*.ts text eol=lf
*.qm binary

# Preserve upstream font bytes and licenses on Windows as well as macOS. The OFL
# notices retain upstream trailing spaces, including in the generated aggregate.
*.ttf binary
src/solaris/ui/fonts/*/OFL.txt text eol=lf whitespace=-blank-at-eol
src/solaris/ui/fonts/sources.json text eol=lf
src/solaris/licenses/THIRD_PARTY_NOTICES.txt text eol=lf whitespace=-blank-at-eol
